{
  "name": "woodstop-local-inbox",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-15",
  "compatibility_flags": ["nodejs_compat"],
  "build": { "command": "npm run build:sample" },
  "assets": { "binding": "ASSETS", "directory": "./dist", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*"] },
  "vars": {
    "APP_ORIGIN": "http://127.0.0.1:8787",
    "LOCAL_DEVELOPMENT": "true",
    "ADMIN_USER_IDS": "local-inbox-test-admin",
    "BETTER_AUTH_SECRET": "local-development-only-never-use-on-a-public-site-woodstop"
  },
  "d1_databases": [{ "binding": "INBOX_DB", "database_name": "woodstop-inbox", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }]
}
